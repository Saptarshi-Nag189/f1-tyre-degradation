# Virtual environment (contains the working CUDA torch build - never commit, never rebuild)
.venv/

# Data and derived artefacts
data/
cache/
artifacts/
results/
logs/

# Serialised formats
*.pkl
*.parquet
*.pth

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# LaTeX build artefacts
*.aux
*.log
*.out
*.synctex.gz

# Local environment record. A full pip freeze of a development venv is not
# this project's dependency surface: it drags in unrelated transitive
# packages and produces permanent Dependabot noise. requirements.txt is the
# manifest.
requirements.lock.txt
